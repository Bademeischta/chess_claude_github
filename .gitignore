# Python
__pycache__/
*.py[cod]
*.pyd

# Build artifacts
build/
dist/
*.egg-info/

# Model checkpoints — tracked via Git LFS for specific files
# checkpoints/ dir is NOT ignored so file-level negations work
checkpoints/*.pt
checkpoints/*.ckpt
*.pt
*.ckpt

# Allow specific checkpoint files needed to resume / inspect training
!checkpoints/latest.pt
!checkpoints/step_0063400.pt
!checkpoints/net_step0.pt
!checkpoints/net_step35000.pt

# Training artifacts
# runs/ is included (TensorBoard logs + supervisor.log)
replay_buffer/
*.replay
*.log
!runs/*.log

# Environments
venv/
.venv/
env/
.env
*.env

# Claude Code internal
.claude/

# Syzygy tablebases (~939 MB binary, regenerable via tools/download_syzygy.py)
syzygy/
*.rtbw
*.rtbz
