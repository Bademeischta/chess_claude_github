# Python
__pycache__/
*.py[cod]
*.pyd

# Build artifacts
build/
dist/
*.egg-info/

# Model checkpoints — NEVER commit these. Each step_*.pt is ~278 MB;
# force-tracking latest.pt / step_* in the past bloated .git to ~3.8 GB.
# They are training artifacts (regenerated continuously), not source —
# keep them out of git entirely. To inspect/share a specific net, copy it
# out of the repo manually rather than committing it.
checkpoints/
*.pt
*.ckpt
*.onnx

# Training artifacts
# runs/ is included (TensorBoard logs + supervisor.log)
replay_buffer/
*.replay
*.log
!runs/*.log

# Environments
venv/
.venv/
env/
.env
*.env

# Claude Code internal
.claude/

# Syzygy tablebases (~939 MB binary, regenerable via tools/download_syzygy.py)
syzygy/
*.rtbw
*.rtbz
